# Public profile information
PROFILE_NAME=Your_Name
PROFILE_USERNAME=your-username
PROFILE_BIO=

# Platform usernames (blank disables a provider)
GITHUB_USERNAME=
GITHUB_TOKEN=
LEETCODE_USERNAME=
CODEFORCES_USERNAME=
HACKERRANK_USERNAME=

# LeetCode credentials (optional). Needed only for the full solved-problem list,
# and only for the account named in LEETCODE_USERNAME. Copy the LEETCODE_SESSION
# and csrftoken cookie values from your browser. Never commit real values.
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=


# Option A: raw cookie string copied from the browser
# DevTools -> Network -> any request to *.geeksforgeeks.org -> Request Headers -> cookie
#GFG_COOKIE=gfguserName=yourhandle; csrftoken=abc123...; sessionid=...; other=...

# Option B(1st choice): login with username/email and password
GFG_USERNAME=you@example.com
GFG_PASSWORD=your-password

# Optional
#GFG_CONCURRENCY=16
#GFG_UTC_OFFSET_MINUTES=330


CSES_USERNAME=
CSES_PASSWORD=

# Backend
REQUEST_TIMEOUT=15
CACHE_TTL=600

